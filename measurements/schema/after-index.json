e Falls\",\n    \"addressRegion\": \"OR\",\n    \"postalCode\": \"97000\",\n    \"addressCountry\": \"US\"\n  },\n  \"areaServed\": [\n    \"Marlowe Falls\",\n    \"Cedar Hollow\",\n    \"Pike Crossing\"\n  ],\n  \"openingHoursSpecification\": [\n    {\n      \"@type\": \"OpeningHoursSpecification\",\n      \"dayOfWeek\": [\n        \"Monday\",\n        \"Tuesday\",\n        \"Wednesday\",\n        \"Thursday\",\n        \"Friday\"\n      ],\n      \"opens\": \"07:00\",\n      \"closes\": \"18:00\"\n    }\n  ]\n}\n\u003c/script\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cnav\u003e\u003ca href\u003d\"index.html\"\u003eHome\u003c/a\u003e | \u003ca href\u003d\"services.html\"\u003eServices\u003c/a\u003e | \u003ca href\u003d\"about.html\"\u003eAbout \u0026amp; Contact\u003c/a\u003e | \u003ca href\u003d\"faq.html\"\u003eFAQ\u003c/a\u003e\u003c/nav\u003e\n\u003ch1\u003eEmergency and Everyday Plumbing in Marlowe Falls, Oregon\u003c/h1\u003e\n\u003cp\u003eLarkspur Lane Plumbing is a licensed plumbing company serving Marlowe Falls, Cedar Hollow and Pike Crossing. We answer emergency calls 24 hours a day on (555) 010-0142 and quote the full price before work starts.\u003c/p\u003e\n\u003cimg src\u003d\"images/van.svg\" alt\u003d\"Larkspur Lane Plumbing service van parked outside a Marlowe Falls home\"\u003e\n\u003ch2\u003eWhat we fix most often\u003c/h2\u003e\n\u003cul\u003e\u003cli\u003eBlocked drains and slow sinks\u003c/li\u003e\u003cli\u003eLeaking pipes and taps\u003c/li\u003e\u003cli\u003eWater heater repair and replacement\u003c/li\u003e\u003cli\u003eToilet, sink and shower installs\u003c/li\u003e\u003c/ul\u003e\n\u003cp\u003eSee \u003ca href\u003d\"services.html\"\u003ewhat each job involves\u003c/a\u003e or read \u003ca href\u003d\"faq.html\"\u003eanswers to common questions\u003c/a\u003e.\u003c/p\u003e\n\u003ch2\u003eHours and service area\u003c/h2\u003e\n\u003cp\u003eOffice hours are Monday to Friday, 7:00 to 18:00. Emergency calls are taken at any hour. We travel up to 20 miles from 14 Mill Street.\u003c/p\u003e\n\u003cfooter\u003e\n\u003caddress\u003e\u003cstrong\u003eLarkspur Lane Plumbing\u003c/strong\u003e\u003cbr\u003e\n14 Mill Street, Marlowe Falls, OR 97000\u003cbr\u003e\nPhone: \u003ca href\u003d\"tel:+15550100142\"\u003e(555) 010-0142\u003c/a\u003e\u003c/address\u003e\n\u003cp\u003e\u003ctime datetime\u003d\"2026-10-01\"\u003eLast reviewed: October 1, 2026\u003c/time\u003e by Dana Whitlock, licensed plumber\u003c/p\u003e\n\u003c/footer\u003e\n\u003c/body\u003e\n\u003c/html\u003e","errors":[],"totalNumErrors":0,"totalNumWarnings":0}